---
import { site } from "../data/siteContent";
---

<section class="relative w-full noise-overlay overflow-hidden">
  <!-- Radial gradient background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,#1a2e1f_0%,#0B1411_70%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_600px_at_80%_80%,rgba(92,107,58,0.08)_0%,transparent_70%)]"></div>

  <div class="relative z-10 container-main pt-20 pb-24 lg:pt-32 lg:pb-36 text-center">
    <!-- Eyebrow -->
    <p class="text-olive2 text-xs font-heading font-semibold uppercase tracking-[0.18em] mb-4">
      Attention Western PA Landowners (2+ Acres)
    </p>

    <!-- Headline -->
    <h1 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl lg:text-[3.75rem] text-text leading-[1.06] tracking-tight max-w-4xl mx-auto">
      Transform Overgrown Acres Into a Park-Like Finish This Week
    </h1>

    <!-- Subheadline -->
    <p class="mt-5 text-muted text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
      Unlock thousands in property equity using our low-disturbance Keystone Digital Scoping System. Zero debris. Zero hauling. 100% usable land.
    </p>

    <!-- Badges -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-8">
      {[
        { icon: "✓", label: "Professionally Vetted Specialist Crews" },
        { icon: "◎", label: "Proprietary Digital Scoping Audit" },
        { icon: "⚡", label: "Zero-Debris, Low-Disturbance Finish" },
      ].map((item) => (
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-olive/20 text-olive2 flex items-center justify-center text-[10px] font-bold">
            {item.icon}
          </span>
          <span class="text-muted text-sm font-medium">{item.label}</span>
        </div>
      ))}
    </div>

    <!-- CTA Framing -->
    <p class="mt-10 text-muted text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
      Unusable brush isn't just an eyesore &mdash; it's lost equity. Our Digital Scoping System reveals how much usable land you're losing and delivers a 72-hour transformation plan.
    </p>

    <!-- CTAs -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/quote" class="btn btn-primary">
        Get Your Property Reclamation Audit
      </a>
      <a
        href={`tel:${site.phone.replace(/\D/g, "")}`}
        class="btn btn-outline !py-3 !px-6 !text-sm"
      >
        Call {site.phone}
      </a>
    </div>

    <!-- Price anchor -->
    <p class="mt-6 text-muted/60 text-[13px] tracking-wide max-w-xl mx-auto">
      The Keystone Standard: Minimum project investment starts at $4,000.
    </p>
  </div>

  <!-- Bottom fade line -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
</section>
