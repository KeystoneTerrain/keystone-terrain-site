# Mapbox GL JS — public access token (used client-side for map tiles & geocoding)
# Get yours free at https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Resend — email delivery for quote form submissions
# Sign up free at https://resend.com, then create an API key
# Add this to Vercel: Settings → Environment Variables
RESEND_API_KEY=re_your_resend_api_key_here
